# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 웹폰트 원본 — 변환 결과(src/fonts/*.woff2)만 저장소에 올린다
/fonts

# 메뉴 이미지 원본 — public/img/menu/*.webp 만 저장소에 올린다
/image
/img-src

# 브랜드북 원본 — public/img/book/*.webp 만 저장소에 올린다
/books
