# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 웹폰트 원본 — 변환 결과(src/fonts/*.woff2)만 저장소에 올린다
/fonts

# 메뉴 이미지 원본 — public/img/menu/*.webp 만 저장소에 올린다
/image
/img-src

# 브랜드북 원본 — public/img/book/*.webp 만 저장소에 올린다
/books

# 프로세스 북 원본 — public/img/book/*.webp 만 저장소에 올린다
/process book
/fianl books

# 3D 원본 — public/models/*.glb 만 저장소에 올린다
/glb

# 홀드 원본 사진 — public/img/holds/*.webp 만 저장소에 올린다
/HOLDER (C)

# 홀드 상세 뷰 원본 — public/img/holds/views/*.webp 만 저장소에 올린다
/holder thumnail

# 전시 페이지는 exhibition/ 이 원본이다. 빌드가 여기로 복사한다
/public/exhibition
